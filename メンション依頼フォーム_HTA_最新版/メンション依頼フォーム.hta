                <div class="attendance-zone" id="attendanceGroup2" role="radiogroup" aria-labelledby="attendanceLabel2" aria-required="true">
                    <label class="group-title" id="attendanceLabel2">出社状況</label>
                    <label class="checkline"><input type="radio" name="attendance2" id="attendanceWork2" value="出社" onclick="attendanceChanged(2);"> 出社</label>
                    <label class="checkline"><input type="radio" name="attendance2" id="attendanceOff2" value="公休" onclick="attendanceChanged(2);"> 公休</label>
                    <label class="checkline"><input type="radio" name="attendance2" id="attendanceShort2" value="時短（時間外）" onclick="attendanceChanged(2);"> 時短（時間外）</label>
                </div>

                <div class="field proxy-ca" id="proxyCAField2">
                    <label for="proxyCA2_1">代理CA名</label>
                    <div class="proxy-ca-main">
                        <input type="text" id="proxyCA2_1" disabled>
                        <input type="text" id="proxyCA2_2" disabled class="stacked">
                        <input type="text" id="proxyCA2_3" disabled class="stacked">
                    </div>

                    <button type="button"
                            id="proxyCAToggle2"
                            class="proxy-ca-float-toggle"
                            aria-expanded="false"
                            title="代理CA4～8を入力"
                            onclick="toggleProxyCAFloat(2,event);"
                            disabled>＋</button>
                    <span id="proxyCABadge2" class="proxy-ca-count-badge" aria-hidden="true"></span>

                    <div id="proxyCAFloat2" class="proxy-ca-float-panel hidden">
                        <div class="proxy-ca-float-title">追加の代理CA</div>
                        <input type="text" id="proxyCA2_4" disabled>
                        <input type="text" id="proxyCA2_5" disabled class="stacked">
                        <input type="text" id="proxyCA2_6" disabled class="stacked">
                        <input type="text" id="proxyCA2_7" disabled class="stacked">
                        <input type="text" id="proxyCA2_8" disabled class="stacked">
                    </div>
                </div>

                <div class="option-zone" id="options2">
                    <label>オプション</label>
                    <label class="checkline" id="noProxyOption2" style="display:none"><input type="checkbox" id="noProxy2" onclick="attendanceChanged(2);"> 代理CA記載なし</label>
                </div>

                <div class="detail-zone">
                    <div class="detail-top">
                        <div class="field mail">
                            <label>メールメモ</label>
                            <input type="text" id="mailMemo2">
                        </div>

                        <div class="field processed">
                            <label>処理日時</label>
                            <input type="text" id="processedAt2">
                        </div>

                        <div class="field due">
                            <label>期日または面接日程</label>
                            <input type="text" id="dueDate2">
                        </div>
                    </div>

                    <div class="type-area">
                        <label>タイプ</label>
                        <select id="type2"></select>
                    </div>
                </div>

            </div>

            <div class="input-note" id="inputNote2">
                <div class="input-note-title">＜入力時の注意事項＞</div>
                <div>組織・CA名はCanvasからコピーしてください</div>
            </div>

            <div class="card-action-row">
                <button type="button" class="sub-button" id="btnAdd3" onclick="showRequest(3);">3件目を入力</button>
                <button type="button" class="cancel-request-button" onclick="requestCancel(2);">× この依頼を取り消す</button>
                <button type="button" class="sub-button clear-request-button" onclick="clearRequest(2);">クリア</button>
            </div>
        </div>
    </div>


    <div class="request-card card3 hidden" id="request3">
        <div class="accent"></div>
        <div class="card-inner">
            <div class="section-title">依頼 3</div>

            <div class="main-row">
                <div class="field org">
                    <label>組織</label>
                    <input type="text" id="org3">
                    <label class="checkline same-ca-inline">
                        <input type="checkbox" id="sameCA3" onclick="toggleSameCA(3);">
                        <span id="sameCALabel3">依頼2と同一CA</span>
                    </label>
                </div>

                <div class="field ca">
                    <label>CA名</label>
                    <input type="text" id="ca3">
                </div>

                <div class="attendance-zone" id="attendanceGroup3" role="radiogroup" aria-labelledby="attendanceLabel3" aria-required="true">
                    <label class="group-title" id="attendanceLabel3">出社状況</label>
                    <label class="checkline"><input type="radio" name="attendance3" id="attendanceWork3" value="出社" onclick="attendanceChanged(3);"> 出社</label>
                    <label class="checkline"><input type="radio" name="attendance3" id="attendanceOff3" value="公休" onclick="attendanceChanged(3);"> 公休</label>
                    <label class="checkline"><input type="radio" name="attendance3" id="attendanceShort3" value="時短（時間外）" onclick="attendanceChanged(3);"> 時短（時間外）</label>
                </div>

                <div class="field proxy-ca" id="proxyCAField3">
                    <label for="proxyCA3_1">代理CA名</label>
                    <div class="proxy-ca-main">
                        <input type="text" id="proxyCA3_1" disabled>
