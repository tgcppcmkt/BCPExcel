                            aria-expanded="false"
                            title="代理CA4～8を入力"
                            onclick="toggleProxyCAFloat(3,event);"
                            disabled>＋</button>
                    <span id="proxyCABadge3" class="proxy-ca-count-badge" aria-hidden="true"></span>

                    <div id="proxyCAFloat3" class="proxy-ca-float-panel hidden">
                        <div class="proxy-ca-float-title">追加の代理CA</div>
                        <input type="text" id="proxyCA3_4" disabled>
                        <input type="text" id="proxyCA3_5" disabled class="stacked">
                        <input type="text" id="proxyCA3_6" disabled class="stacked">
                        <input type="text" id="proxyCA3_7" disabled class="stacked">
                        <input type="text" id="proxyCA3_8" disabled class="stacked">
                    </div>
                </div>

                <div class="option-zone" id="options3">
                    <label>オプション</label>
                    <label class="checkline" id="noProxyOption3" style="display:none"><input type="checkbox" id="noProxy3" onclick="attendanceChanged(3);"> 代理CA記載なし</label>
                </div>

                <div class="detail-zone">
                    <div class="detail-top">
                        <div class="field mail">
                            <label>メールメモ</label>
                            <input type="text" id="mailMemo3">
                        </div>

                        <div class="field processed">
                            <label>処理日時</label>
                            <input type="text" id="processedAt3">
                        </div>

                        <div class="field due">
                            <label>期日または面接日程</label>
                            <input type="text" id="dueDate3">
