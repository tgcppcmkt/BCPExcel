<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=11">
<title>メンション依頼フォーム</title>

<hta:application
    id="MentionRequestApp"
    applicationname="MentionRequest"
    border="thin"
    borderstyle="normal"
    caption="yes"
    contextmenu="no"
    maximizebutton="yes"
    minimizebutton="yes"
    navigable="no"
    scroll="no"
    selection="no"
    showintaskbar="yes"
    singleinstance="no"
    sysmenu="yes"
    version="1.0"
    windowstate="normal"
/>

<link rel="stylesheet" type="text/css" href="mention-form.css">

<script language="VBScript">
Function GetWindowsDisplayNameHTA()
    Dim shell
    Dim userName
    Dim domainName
    Dim objUser
    Dim fullName

    On Error Resume Next

    Set shell = CreateObject("WScript.Shell")
    userName = shell.ExpandEnvironmentStrings("%USERNAME%")
    domainName = shell.ExpandEnvironmentStrings("%USERDOMAIN%")
    fullName = ""

    Err.Clear

    If Len(domainName) > 0 And Len(userName) > 0 Then
        Set objUser = GetObject("WinNT://" & domainName & "/" & userName & ",user")

        If Err.Number = 0 Then
            If Not objUser Is Nothing Then
                fullName = Trim(CStr(objUser.FullName))
            End If
        End If
    End If

    If Len(fullName) > 0 Then
        GetWindowsDisplayNameHTA = fullName
    Else
        GetWindowsDisplayNameHTA = userName
    End If

    On Error GoTo 0
End Function
</script>

<script type="text/javascript" src="mention-form.js"></script>
</head>

<body onload="initApp();">
<object id="HHCtrlMinimizeWindowObject"
        classid="clsid:adb880a6-d8ff-11cf-9377-00aa003b7a11"
        width="0" height="0"
        style="position:absolute;left:-9999px;top:-9999px;">
    <param name="Command" value="Minimize">
</object>

<div id="app">


    <div class="request-card card1" id="request1">
        <div class="accent"></div>
        <div class="card-inner">
            <div class="section-title">依頼 1</div>

            <div class="main-row">
                <div class="field org">
                    <label>組織</label>
                    <input type="text" id="org1">
                </div>

                <div class="field ca">
                    <label>CA名</label>
                    <input type="text" id="ca1">
                </div>

                <div class="attendance-zone" id="attendanceGroup1" role="radiogroup" aria-labelledby="attendanceLabel1" aria-required="true">
                    <label class="group-title" id="attendanceLabel1">出社状況</label>
                    <label class="checkline"><input type="radio" name="attendance1" id="attendanceWork1" value="出社" onclick="attendanceChanged(1);"> 出社</label>
                    <label class="checkline"><input type="radio" name="attendance1" id="attendanceOff1" value="公休" onclick="attendanceChanged(1);"> 公休</label>
                    <label class="checkline"><input type="radio" name="attendance1" id="attendanceShort1" value="時短（時間外）" onclick="attendanceChanged(1);"> 時短（時間外）</label>
                </div>

                <div class="field proxy-ca" id="proxyCAField1">
                    <label for="proxyCA1_1">代理CA名</label>
                    <div class="proxy-ca-main">
                        <input type="text" id="proxyCA1_1" disabled>
                        <input type="text" id="proxyCA1_2" disabled class="stacked">
                        <input type="text" id="proxyCA1_3" disabled class="stacked">
                    </div>

                    <button type="button"
                            id="proxyCAToggle1"
                            class="proxy-ca-float-toggle"
                            aria-expanded="false"
                            title="代理CA4～8を入力"
                            onclick="toggleProxyCAFloat(1,event);"
                            disabled>＋</button>
                    <span id="proxyCABadge1" class="proxy-ca-count-badge" aria-hidden="true"></span>

                    <div id="proxyCAFloat1" class="proxy-ca-float-panel hidden">
                        <div class="proxy-ca-float-title">追加の代理CA</div>
                        <input type="text" id="proxyCA1_4" disabled>
                        <input type="text" id="proxyCA1_5" disabled class="stacked">
                        <input type="text" id="proxyCA1_6" disabled class="stacked">
                        <input type="text" id="proxyCA1_7" disabled class="stacked">
                        <input type="text" id="proxyCA1_8" disabled class="stacked">
                    </div>
                </div>

                <div class="option-zone" id="options1">
                    <label>オプション</label>
                    <label class="checkline" id="noProxyOption1" style="display:none"><input type="checkbox" id="noProxy1" onclick="attendanceChanged(1);"> 代理CA記載なし</label>
                </div>

                <div class="detail-zone">
                    <div class="detail-top">
                        <div class="field mail">
                            <label>メールメモ</label>
                            <input type="text" id="mailMemo1">
                        </div>

                        <div class="field processed">
                            <label>処理日時</label>
                            <input type="text" id="processedAt1">
                        </div>

                        <div class="field due">
                            <label>期日または面接日程</label>
                            <input type="text" id="dueDate1">
                        </div>
                    </div>

                    <div class="type-area">
                        <label>タイプ</label>
                        <select id="type1"></select>
                    </div>
                </div>

            </div>

            <div class="input-note" id="inputNote1">
                <div class="input-note-title">＜入力時の注意事項＞</div>
                <div>組織・CA名はCanvasからコピーしてください</div>
            </div>

            <div class="card-action-row">
                <button type="button" class="sub-button" id="btnAdd2" onclick="showRequest(2);">2件目を入力</button>
                <button type="button" class="sub-button clear-request-button" onclick="clearRequest(1);">クリア</button>
            </div>
        </div>
    </div>


    <div class="request-card card2 hidden" id="request2">
        <div class="accent"></div>
        <div class="card-inner">
            <div class="section-title">依頼 2</div>

            <div class="main-row">
                <div class="field org">
                    <label>組織</label>
                    <input type="text" id="org2">
                    <label class="checkline same-ca-inline">
                        <input type="checkbox" id="sameCA2" onclick="toggleSameCA(2);">
