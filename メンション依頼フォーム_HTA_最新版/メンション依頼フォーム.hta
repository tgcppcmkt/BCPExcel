    </div>


    <div id="footerBar">
        <div class="footer-field base-field">
            <label>拠点</label>
            <select id="requestBase"></select>
        </div>

        <div class="footer-field requester-field">
            <label>依頼者</label>
            <div id="requesterName" class="requester-value"></div>
        </div>

        <div class="footer-grow"></div>

        <div id="pendingRetryArea" class="pending-retry-area hidden">
            <div id="pendingRetryText" class="pending-retry-text"></div>
            <button type="button" id="retryPendingButton" onclick="retryPendingPackages();">未送信を再送</button>
        </div>

<button type="button" id="sendButton" onclick="sendRequest();">送信</button>
    </div>

</div>


<div id="sendConfirmOverlay" class="modal-overlay hidden" onkeydown="handleSendConfirmKey(event);">
    <div id="sendConfirmModal" class="validation-modal modal-neutral send-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="sendConfirmTitle" aria-describedby="sendConfirmMessage">
        <div id="sendConfirmTitle" class="modal-title">送信前確認</div>
        <div class="send-confirm-warning">メールメモに【個人】【企業】情報記載はNGです</div>
        <div id="sendConfirmMessage" class="modal-message">
            <div class="send-confirm-question">出社状況は相違ないですか？</div>
            <div id="sendConfirmDetails" class="send-confirm-details"></div>
        </div>
        <div class="cancel-modal-actions">
            <button type="button" id="sendConfirmYes" class="modal-ok" onclick="confirmSendRequest();">はい</button>
            <button type="button" id="sendConfirmNo" class="cancel-modal-back" onclick="closeSendConfirm();">いいえ</button>
        </div>
    </div>
</div>

<div id="cancelModalOverlay" class="modal-overlay hidden">
    <div id="cancelConfirmModal" class="validation-modal modal-request2 cancel-confirm-modal">
        <div id="cancelModalTitle" class="modal-title">依頼の取り消し確認</div>
        <div id="cancelModalMessage" class="modal-message"></div>
        <div class="cancel-modal-actions">
            <button type="button" id="cancelBackButton" class="cancel-modal-back" onclick="closeCancelConfirm();">戻る</button>
            <button type="button" id="cancelDoButton" class="cancel-modal-do" onclick="confirmCancelRequest();">取り消す</button>
        </div>
    </div>
</div>

<div id="modalOverlay" class="modal-overlay hidden">
    <div id="validationModal" class="validation-modal modal-neutral">
        <div id="modalTitle" class="modal-title">入力確認</div>
        <div id="modalMessage" class="modal-message"></div>
        <div class="modal-actions">
            <button type="button" id="modalOkButton" class="modal-ok" onclick="closeValidationModal();">OK</button>
        </div>
    </div>
</div>


<div id="systemModalOverlay" class="system-modal-overlay hidden">
    <div id="systemModal" class="system-modal system-modal-accepted">
        <div id="systemModalTitle" class="system-modal-title">受付完了</div>
        <div id="systemModalMessage" class="system-modal-message"></div>
        <div class="system-modal-actions">
            <button type="button" id="systemModalOkButton" onclick="hideSystemModal();">OK</button>
        </div>
    </div>
</div>

</body>
</html>